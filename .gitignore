# .NET build output
bin/
obj/
*.user
*.suo
.vs/

# Publish output
publish/

# Auto-generated by `dotnet publish` on first run; redundant with the
# RuntimeIdentifiers/publish properties already in the .csproj + README.
Properties/PublishProfiles/

# Secrets / local config
.env
appsettings.Development.json
appsettings.Local.json

# Runtime/local state (mirrors the Python project's data/ convention)
data/
downloads/
uploads/
logs/
*.session
*.session.db

# Real channel config (keep only channels.example.yaml tracked)
config/channels.yaml

# Editor/OS cruft
.idea/
*.swp
.DS_Store
Thumbs.db
