# .NET build output
bin/
obj/
*.user
*.suo
.vs/

# Publish output
publish/

# Packaged release zips (scripts/build-release-package.ps1)
dist/

# Auto-generated by `dotnet publish` on first run; redundant with the
# RuntimeIdentifiers/publish properties already in the .csproj + README.
Properties/PublishProfiles/

# Secrets / local config
.env
appsettings.Development.json
appsettings.Local.json

# Runtime/local state (mirrors the Python project's data/ convention)
data/
downloads/
uploads/
logs/
*.session
*.session.db

# Real channel config (keep only channels.example.yaml tracked)
config/channels.yaml

# Backup copies of anything (configs, .env, etc.) -- never meant to be
# committed, but easy to leave lying around next to the real file
# (e.g. config/channels.yaml.bk before an edit).
*.bk
*.bak

# Editor/OS cruft
.idea/
*.swp
.DS_Store
Thumbs.db
