TG_API_ID=123456
TG_API_HASH=your_api_hash_here
TG_PHONE=+15551234567
TG_SESSION_NAME=data/downloader

# Destination root for audiobook_mode channels (config/channels.yaml).
# Named generically because this is really "wherever your local media
# server's library lives" -- point it at a Plex/Jellyfin/etc. library
# mount if you have one; defaults to downloads/Audiobooks otherwise.
LOCAL_MEDIA_SERVER=downloads/Audiobooks

# Optional overrides of other defaults (rarely needed):
# CHANNELS_CONFIG_PATH=config/channels.yaml
# STATE_DB_PATH=data/state.db
# LOG_FILE_PATH=logs/app.log
